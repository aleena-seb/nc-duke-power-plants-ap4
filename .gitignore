# ------------------------------------------------------------------------------
# Data Directories & Heavy Data Artifacts
# ------------------------------------------------------------------------------

#Ignore keys
R/keys.R


# Ignore all files in data directories
data/raw/*
data/intermediate/*
data/final/*

# Keep directory structures tracked
!data/raw/.gitkeep
!data/intermediate/.gitkeep
!data/final/.gitkeep

# Explicitly keep the project proposed units roster tracked
!data/raw/proposed_units_11.csv

# Ignore large analytical data formats
*.dta
*.parquet
*.rds
*.fst
*.feather
*.zip
*.tar.gz
*.7z

# macOS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

